{
  "name": "pptx-preview",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "keywords": [
    "powerpoint",
    "pptx"
  ],
  "dependencies": {
    "jszip": ">=3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "jsdom": "^29.1.1",
    "rollup": "^4.9.1",
    "tslib": "^2.4.0",
    "typescript": "^5.0.3"
  },
  "scripts": {
    "build": "rollup --config rollup.config.mjs",
    "build-prod": "rollup --config rollup.config.mjs --environment BUILD:production",
    "watch": "rollup --config rollup.config.mjs --watch",
    "serve": "node scripts/dev-server.mjs",
    "dev": "npm run build && npm run serve",
    "test": "playwright test",
    "e2e": "playwright test",
    "e2e-watch": "playwright test --ui"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/pptx-preview.mjs",
      "require": "./dist/pptx-preview.js",
      "types": "./dist/pptx-preview.d.ts"
    }
  },
  "types": "dist/pptx-preview.d.ts"
}
